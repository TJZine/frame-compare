# Enforce Windows line endings for portable install scripts.
install.cmd text eol=crlf
install.ps1 text eol=crlf
tools/windows_portable/*.cmd text eol=crlf
tools/windows_portable/shim/*.cmd text eol=crlf
tools/windows_portable/*.ps1 text eol=crlf
tools/windows_portable/shim/*.ps1 text eol=crlf

# Vendored license files that are byte-hashed must use deterministic LF endings.
tools/windows_portable/licenses/**/*.txt text eol=lf
tools/windows_portable/licenses/**/*.txt whitespace=-blank-at-eof
src/frame_compare/assets/fonts/Inter-OFL.txt text eol=lf
