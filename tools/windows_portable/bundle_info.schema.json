{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frame-compare.dev/schemas/windows-portable/bundle-info.schema.json",
  "title": "Frame Compare Bundle Info",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_kind",
    "app_version",
    "requirements_lock_sha256",
    "manifest_version",
    "platform",
    "media_runtime_fingerprint",
    "media_runtime_fingerprints"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3
    },
    "bundle_kind": {
      "type": "string",
      "const": "full"
    },
    "app_version": {
      "type": "string",
      "minLength": 1
    },
    "requirements_lock_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest_version": {
      "type": "integer",
      "const": 2
    },
    "platform": {
      "type": "string",
      "const": "windows-x64"
    },
    "media_runtime_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "media_runtime_fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis",
        "probe",
        "alignment",
        "index",
        "full"
      ],
      "properties": {
        "analysis": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "probe": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "alignment": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "index": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "full": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
