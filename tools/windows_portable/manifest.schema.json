{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frame Compare Windows Portable Bundle Manifest",
  "type": "object",
  "required": [
    "manifest_version",
    "bundle",
    "artifacts",
    "corresponding_sources"
  ],
  "properties": {
    "manifest_version": {
      "type": "integer",
      "const": 2
    },
    "bundle": {
      "type": "object",
      "required": [
        "platform",
        "arch",
        "vs_ref",
        "python_version",
        "ffmpeg_policy",
        "runtime_fingerprints"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "windows"
          ]
        },
        "arch": {
          "type": "string",
          "enum": [
            "x64"
          ]
        },
        "vs_ref": {
          "type": "string"
        },
        "python_version": {
          "type": "string"
        },
        "ffmpeg_policy": {
          "type": "string",
          "enum": [
            "lgpl-only"
          ]
        },
        "notes": {
          "type": "string"
        },
        "plugin_layout": {
          "type": "string"
        },
        "runtime_fingerprints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "analysis",
            "probe",
            "alignment",
            "index",
            "full"
          ],
          "properties": {
            "analysis": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "probe": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "alignment": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "index": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "full": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "corresponding_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/corresponding_source"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "url",
        "source_url",
        "sha256",
        "bytes",
        "license",
        "install"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "build_source_url": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "license": {
          "type": "object",
          "required": [
            "spdx",
            "url"
          ],
          "properties": {
            "spdx": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/license_file"
              }
            },
            "notes": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "install": {
          "$ref": "#/$defs/install"
        },
        "notes": {
          "type": "string"
        },
        "release_date": {
          "type": "string",
          "format": "date"
        },
        "source_kind": {
          "type": "string",
          "enum": [
            "release",
            "tag",
            "commit"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "build_source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "build_source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "build_source_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "bundled_dependencies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/bundled_dependency"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "source_sha256"
                ]
              },
              {
                "required": [
                  "source_bytes"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "source_sha256",
              "source_bytes"
            ]
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "build_source_sha256"
                ]
              },
              {
                "required": [
                  "build_source_bytes"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "build_source_sha256",
              "build_source_bytes"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "bundled_dependency": {
      "type": "object",
      "required": [
        "name",
        "version",
        "selection_kind",
        "source_ref",
        "source_commit",
        "source_tree_sha256",
        "license"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "selection_kind": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "source_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "source_tree_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "license": { "type": "string", "minLength": 1 },
        "package_url": { "type": "string", "format": "uri" },
        "package_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "package_bytes": { "type": "integer", "minimum": 0 },
        "binary_path": { "type": "string", "minLength": 1 },
        "binary_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "binary_bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "corresponding_source": {
      "type": "object",
      "required": [
        "name",
        "version",
        "license",
        "source_url",
        "sha256",
        "bytes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "selection_kind": {
          "type": "string",
          "enum": [
            "release",
            "tag",
            "commit"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "release_date": {
          "type": "string",
          "format": "date"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "additionalProperties": false
    },
    "license_file": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "install": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "destination"
          ],
          "properties": {
            "type": {
              "const": "extract"
            },
            "destination": {
              "type": "string"
            },
            "strip_prefix": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "python_wheel"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
