{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frame Compare Windows Portable Bundle Manifest",
  "type": "object",
  "required": ["manifest_version", "bundle", "artifacts"],
  "properties": {
    "manifest_version": {
      "type": "integer",
      "const": 1
    },
    "bundle": {
      "type": "object",
      "required": ["platform", "arch", "vs_ref", "python_version", "ffmpeg_policy"],
      "properties": {
        "platform": { "type": "string", "enum": ["windows"] },
        "arch": { "type": "string", "enum": ["x64"] },
        "vs_ref": { "type": "string" },
        "python_version": { "type": "string" },
        "ffmpeg_policy": { "type": "string", "enum": ["lgpl-only"] },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["id", "name", "version", "url", "sha256", "license"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "license": {
          "type": "object",
          "required": ["spdx", "url"],
          "properties": {
            "spdx": { "type": "string" },
            "url": { "type": "string", "format": "uri" },
            "notes": { "type": "string" }
          },
          "additionalProperties": false
        },
        "install": {
          "type": "object",
          "required": ["type", "destination"],
          "properties": {
            "type": { "type": "string", "enum": ["extract", "copy_file"] },
            "destination": { "type": "string" },
            "strip_prefix": { "type": "string" },
            "source_path": { "type": "string" }
          },
          "additionalProperties": false
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
