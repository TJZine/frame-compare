{
  "schema_version": 1,
  "description": "Single source of truth for Frame Compare 2.0 readiness gate commands.",
  "gates": [
    {
      "id": "contract_views_freshness",
      "name": "Contract views freshness",
      "cwd": ".",
      "command": "UV_CACHE_DIR=./.uv_cache uv run --no-sync python scripts/generate_contract_views.py --check"
    },
    {
      "id": "scaffold_tier_a",
      "name": "Scaffold Tier‑A suite",
      "cwd": "docs/OPUS_REBUILD_FRAME_COMPARE/scaffold",
      "command": ".venv/bin/pytest -q -m tier_a"
    },
    {
      "id": "traceability_validation",
      "name": "Traceability validation",
      "cwd": ".",
      "command": "UV_CACHE_DIR=./.uv_cache uv run --no-sync python scripts/validate_traceability.py --check"
    }
  ]
}
