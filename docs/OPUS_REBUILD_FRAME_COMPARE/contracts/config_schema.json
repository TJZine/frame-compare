{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://frame-compare.dev/schemas/config.json",
    "title": "Frame Compare Configuration Schema",
    "description": "Configuration field inventory for Frame Compare 2.0",
    "type": "object",
    "properties": {
        "paths": {
            "type": "object",
            "description": "Path configuration",
            "properties": {
                "input_dir": {
                    "type": "string",
                    "default": "comparison_videos"
                },
                "screenshots_dir": {
                    "type": "string",
                    "default": "screenshots"
                },
                "generated_dir": {
                    "type": "string",
                    "default": "generated"
                },
                "config_dir": {
                    "type": "string",
                    "default": "config"
                }
            },
            "additionalProperties": false
        },
        "analysis": {
            "type": "object",
            "description": "Frame analysis configuration",
            "properties": {
                "frame_count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 10
                },
                "random_seed": {
                    "type": "integer",
                    "default": 42
                },
                "save_frames_data": {
                    "type": "boolean",
                    "default": true
                },
                "selection_mode": {
                    "type": "string",
                    "enum": [
                        "quantile",
                        "motion",
                        "random",
                        "mixed"
                    ],
                    "default": "mixed"
                },
                "dark_quantile": {
                    "type": "number",
                    "minimum": 0.0,
                    "maximum": 0.5,
                    "default": 0.05
                },
                "bright_quantile": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 1.0,
                    "default": 0.95
                }
            },
            "additionalProperties": false
        },
        "audio_alignment": {
            "type": "object",
            "description": "Audio alignment configuration",
            "properties": {
                "enable": {
                    "type": "boolean",
                    "default": true
                },
                "sample_rate": {
                    "type": "integer",
                    "minimum": 4000,
                    "maximum": 48000,
                    "default": 8000
                },
                "max_offset_seconds": {
                    "type": "number",
                    "minimum": 1.0,
                    "default": 30.0
                },
                "use_vspreview": {
                    "type": "boolean",
                    "default": false
                },
                "force_interactive": {
                    "type": "boolean",
                    "default": false
                },
                "cache_results": {
                    "type": "boolean",
                    "default": true
                }
            },
            "additionalProperties": false
        },
        "screenshots": {
            "type": "object",
            "description": "Screenshot rendering configuration",
            "properties": {
                "use_ffmpeg": {
                    "type": "boolean",
                    "default": false
                },
                "directory_name": {
                    "type": "string",
                    "default": "screenshots"
                },
                "overlay_mode": {
                    "type": "string",
                    "enum": [
                        "minimal",
                        "standard",
                        "diagnostic",
                        "none"
                    ],
                    "default": "standard"
                },
                "include_frame_number": {
                    "type": "boolean",
                    "default": true
                },
                "png_compression": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9,
                    "default": 6
                },
                "ffmpeg_timeout_seconds": {
                    "type": "number",
                    "minimum": 5.0,
                    "default": 30.0
                }
            },
            "additionalProperties": false
        },
        "color": {
            "type": "object",
            "description": "Color and tonemapping configuration",
            "properties": {
                "enable_tonemap": {
                    "type": "boolean",
                    "default": true
                },
                "preset": {
                    "type": "string",
                    "enum": [
                        "reference",
                        "filmic",
                        "contrast",
                        "bt2390_spec",
                        "spline",
                        "bright_lift",
                        "highlight_guard"
                    ],
                    "default": "reference"
                },
                "target_nits": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 1000,
                    "default": 203
                },
                "tone_curve": {
                    "type": "string",
                    "enum": [
                        "bt2390",
                        "spline",
                        "reinhard",
                        "mobius",
                        "linear"
                    ],
                    "default": "bt2390"
                },
                "gamma_lift": {
                    "type": "boolean",
                    "default": false
                },
                "contrast_recovery": {
                    "type": "number",
                    "minimum": 0.0,
                    "maximum": 1.0,
                    "default": 0.0
                }
            },
            "additionalProperties": false
        },
        "slowpics": {
            "type": "object",
            "description": "slow.pics publishing configuration",
            "properties": {
                "auto_upload": {
                    "type": "boolean",
                    "default": true
                },
                "visibility": {
                    "type": "string",
                    "enum": [
                        "public",
                        "unlisted",
                        "private"
                    ],
                    "default": "unlisted"
                },
                "delete_after_upload": {
                    "type": "boolean",
                    "default": false
                },
                "timeout_seconds": {
                    "type": "number",
                    "minimum": 10.0,
                    "default": 60.0
                },
                "max_retries": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10,
                    "default": 3
                }
            },
            "additionalProperties": false
        },
        "tmdb": {
            "type": "object",
            "description": "TMDB metadata configuration",
            "properties": {
                "api_key": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "default": null
                },
                "enabled": {
                    "type": "boolean",
                    "default": true
                },
                "unattended": {
                    "type": "boolean",
                    "default": false
                },
                "timeout_seconds": {
                    "type": "number",
                    "minimum": 1.0,
                    "default": 10.0
                }
            },
            "additionalProperties": false
        },
        "report": {
            "type": "object",
            "description": "HTML report configuration",
            "properties": {
                "enable": {
                    "type": "boolean",
                    "default": true
                },
                "output_dir": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "default": null
                },
                "default_mode": {
                    "type": "string",
                    "enum": [
                        "slider",
                        "overlay",
                        "diff",
                        "blink"
                    ],
                    "default": "slider"
                },
                "include_filmstrip": {
                    "type": "boolean",
                    "default": true
                },
                "embed_images": {
                    "type": "boolean",
                    "default": false
                }
            },
            "additionalProperties": false
        },
        "dovi": {
            "type": "object",
            "description": "Dolby Vision handling configuration",
            "properties": {
                "enable": {
                    "type": "boolean",
                    "default": true
                },
                "dovi_tool_path": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "default": null
                },
                "cache_results": {
                    "type": "boolean",
                    "default": true
                }
            },
            "additionalProperties": false
        },
        "diagnostics": {
            "type": "object",
            "description": "Diagnostics overlay configuration",
            "properties": {
                "per_frame_nits": {
                    "type": "boolean",
                    "default": false
                },
                "show_hdr_info": {
                    "type": "boolean",
                    "default": false
                },
                "frame_timing": {
                    "type": "boolean",
                    "default": false
                }
            },
            "additionalProperties": false
        },
        "logging": {
            "type": "object",
            "description": "Logging configuration",
            "properties": {
                "level": {
                    "type": "string",
                    "enum": [
                        "DEBUG",
                        "INFO",
                        "WARNING",
                        "ERROR"
                    ],
                    "default": "INFO"
                },
                "format": {
                    "type": "string",
                    "enum": [
                        "json",
                        "console"
                    ],
                    "default": "console"
                },
                "file": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "default": null
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
