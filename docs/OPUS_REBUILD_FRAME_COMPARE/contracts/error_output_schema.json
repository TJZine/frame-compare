{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://frame-compare.dev/schemas/error-output.json",
    "title": "Frame Compare Error Output",
    "description": "JSON output format for Frame Compare errors (--json flag)",
    "type": "object",
    "required": [
        "success",
        "error"
    ],
    "properties": {
        "success": {
            "type": "boolean",
            "const": false
        },
        "error": {
            "type": "object",
            "required": [
                "code",
                "name",
                "message"
            ],
            "properties": {
                "code": {
                    "type": "string",
                    "pattern": "^FC-[0-9]{4}$",
                    "description": "Error code in FC-XXXX format"
                },
                "name": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]*$",
                    "description": "Stable symbolic error name (SCREAMING_SNAKE_CASE)"
                },
                "message": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Human-readable error message"
                },
                "hint": {
                    "type": "string",
                    "description": "Optional actionable hint for resolution"
                },
                "details": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Optional structured details for debugging"
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
